{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "WEB_Demo.Api",
    "Audience": "WEB_Demo.Client",
    "SigningKey": "replace-with-development-or-secret-manager-signing-key",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenRetentionDays": 30,
    "RefreshCookieName": "web_demo.refresh_token"
  },
  "SpecAssistant": {
    "OpenSpecRoot": "../../openspec",
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "MaxQuestionLength": 1000,
    "MaxCandidateChunks": 6,
    "MaxContextCharacters": 12000
  },
  "AllowedHosts": "*"
}
