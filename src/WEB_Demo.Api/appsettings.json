{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "WEB_Demo.Api",
    "Audience": "WEB_Demo.Client",
    "SigningKey": "replace-with-development-or-secret-manager-signing-key",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenRetentionDays": 30,
    "RefreshCookieName": "web_demo.refresh_token"
  },
  "AllowedHosts": "*"
}
